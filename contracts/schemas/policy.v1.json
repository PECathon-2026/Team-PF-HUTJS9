{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacylens.invalid/contracts/policy.v1.json",
  "title": "Policy",
  "description": "The privacy policy (spec section 7): rules with IDs (D- detection, E- egress, A- actions, I- injection, U- user), risk weights and thresholds. Signature fields are verified with LNX's signing library (sprint: signature optional, recorded as unsigned).",
  "x-pl-zone": "metadata",
  "type": "object",
  "properties": {
    "schema": {
      "const": "policy.v1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "effect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[DEAIU]-[0-9]{2,3}$"
          },
          "effect": {
            "enum": [
              "block",
              "redact",
              "ask",
              "allow"
            ]
          },
          "category": {
            "enum": [
              "CARD",
              "AADHAAR",
              "PAN",
              "API_KEY",
              "OTP",
              "PASSWORD",
              "EMAIL",
              "PHONE",
              "IP_ADDRESS",
              "PIN_CODE",
              "BANK_ACCOUNT",
              "IFSC",
              "UPI_ID",
              "PASSPORT",
              "DOB",
              "NAME",
              "ADDRESS",
              "FACE",
              "SECRET",
              "QUASI_ID"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 200,
            "x-pl-scrubbed": true
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weights",
        "allow_below",
        "deny_from"
      ],
      "properties": {
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "irreversible": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "sensitive_value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "new_domain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "goal_distance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "attack_alarm": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "allow_below": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "deny_from": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "signer_key_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16,64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  },
  "required": [
    "schema",
    "version",
    "rules",
    "risk"
  ],
  "additionalProperties": false
}
